APP_ENV=development
PUBLIC_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite+aiosqlite:///./premium_store.db
PAYMENT_MODE=demo
SMS_MODE=demo
# Required in production: generate a random secret of at least 32 characters.
APP_SECRET=
DATA_DIR=.local
MEDIA_DIR=.local/media
# Optional, only after choosing Kavenegar and approving an OTP template:
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Production encryption key: generate with Fernet.generate_key(), preserve privately.
VAULT_KEY=
# Optional outbound Telegram messages; separate from any product synchronization.
TELEGRAM_BOT_TOKEN=
