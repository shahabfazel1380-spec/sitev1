APP_ENV=development
PUBLIC_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite+aiosqlite:///./premium_store.db
PAYMENT_MODE=demo
SMS_MODE=demo
# Required in production: generate a random secret of at least 32 characters.
APP_SECRET=
DATA_DIR=.local
MEDIA_DIR=.local/media
# Optional, only after choosing Kavenegar and approving an OTP template:
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
# Absolute path to the existing bot's SQLite database ON THE SAME SERVER.
# Leave blank until backed up and configured. Never point to the website DB.
BOT_DATABASE_PATH=
